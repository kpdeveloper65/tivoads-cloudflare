{
  "name": "tivoads-cloudflare",
  "version": "2.0.0",
  "description": "Tivoads - Premium Ad Discovery & Research Platform",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build --node-externals jose,@panva/hkdf",
